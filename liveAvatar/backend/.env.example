LIVEAVATAR_API_KEY=your_heygen_key_here
GEMINI_API_KEY=your_gemini_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# Production avatar tier (the /prod URL). Interviews on / or /dev always use
# the free sandbox avatar (~1-min sessions); /prod uses PROD_AVATAR_ID with
# is_sandbox=false, burning credits (2/minute), capped per session by
# PROD_MAX_SESSION_SECONDS. /prod is disabled (503) until BOTH PROD_AVATAR_ID
# and DEMO_PASSCODE are set; the passcode gates prod interview creation so a
# leaked URL can't burn credits. Pick a public avatar id from
# GET /v1/avatars/public (e.g. "June HR" below); PROD_VOICE_ID is optional —
# public video avatars have a default voice.
# PROD_AVATAR_ID=65f9e3c9-d48b-4118-b73a-4ae2e3cbb8f0
# DEMO_PASSCODE=pick-a-passcode
# PROD_VOICE_ID=
# PROD_MAX_SESSION_SECONDS=600

# Required to create avatar sessions: the public URL HeyGen calls back into for
# our LLM gateway (/llm/{interview_id}/v1). In dev, run a tunnel:
# `ngrok http 3001` (see docs/ONBOARDING.md §4.2), and paste its URL here. (On
# Cloud Run this is the service URL itself — no tunnel.)
# PUBLIC_BASE_URL=https://your-domain.ngrok-free.dev

# Post-interview Data Scout (two-pass company research: Tavily web search +
# page fetching + Gemini synthesis; TAVILY_API_KEY above powers all its web
# search — without it, search is silently skipped and reports come back
# near-empty). On by default; set to false to skip research entirely
# (pipeline still runs).
# SCOUT_ENABLED=false

# Optional: per-domain questionnaires. Directory of {domain}.yaml linear question
# scripts, and which domain POST /api/interview uses when no {domain} is given.
# QUESTIONNAIRES_DIR=data/questionnaires
# DEFAULT_DOMAIN=frontier_tech

# Optional: transcript storage backend.
# When GCS_BUCKET is set, finalized interview transcripts + summaries are stored
# in that Google Cloud Storage bucket (blob: transcripts/{session_id}.json),
# using Application Default Credentials. When unset, they are written as local
# JSON files under ./transcripts/ (dev fallback, gitignored).
# GCS_BUCKET=your_bucket_name

# Optional latency polish: stream the Host's reply to HeyGen token-by-token so
# the avatar starts speaking sooner. Off by default; set to true to enable.
# HOST_STREAMING_ENABLED=true

# Model for Data Scout Agent — independent of interview host model.
# Defaults to gemini-flash-latest (same alias the interview Host uses);
# override here to pin a specific version instead.
# SCOUT_GEMINI_MODEL=gemini-flash-latest

# Entity for the Scout's dedicated prior-relationship search + mandatory
# report bullet (a client-rubric requirement). Defaults to "Saudi Aramco";
# set to an empty string to disable the check entirely.
# SCOUT_RELATIONSHIP_CHECK_ENTITY=Saudi Aramco
